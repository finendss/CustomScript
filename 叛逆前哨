Tab2:Toggle({
    Title = "绘制僵尸",
    Default = false,
    Callback = function(state)
        if state then
            getgenv().ESPZombieEnabled = true
            task.spawn(function()
                while getgenv().ESPZombieEnabled do
                    pcall(function()
                        local LocalPlayer = game:GetService("Players").LocalPlayer
                        local char = LocalPlayer.Character
                        if char and char.PrimaryPart then
                            local spawned = workspace.EnemySpawns.Spawned:GetChildren()
                            for i = 1, #spawned do
                                local v = spawned[i]
                                if v.Name == "Lurker" and v.PrimaryPart then
                                    if v:FindFirstChild("ESP") then
                                        local espText = v:FindFirstChild("EspText", true)
                                        if espText then
                                            local distance = math.round((char.PrimaryPart.Position - v.PrimaryPart.Position).Magnitude)
                                            local text = "Lurker\n[" .. distance .. "m]"
                                            if espText.Text ~= text then
                                                espText.Text = text
                                            end
                                        end
                                    else
                                        local distance = math.round((char.PrimaryPart.Position - v.PrimaryPart.Position).Magnitude)
                                        local text = "Lurker\n[" .. distance .. "m]"

                                        local highlight = Instance.new("Highlight")
                                        highlight.Name = "ESP"
                                        highlight.FillTransparency = 1
                                        highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
                                        highlight.Parent = v

                                        local billboard = Instance.new("BillboardGui")
                                        billboard.Parent = v.PrimaryPart
                                        billboard.AlwaysOnTop = true
                                        billboard.Size = UDim2.new(0, 100, 0, 30)
                                        billboard.Name = "EspBili"
                                        billboard.StudsOffset = Vector3.new(0, 3, 0)
                                        billboard.MaxDistance = 500

                                        local textLabel = Instance.new("TextLabel")
                                        textLabel.Parent = billboard
                                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                                        textLabel.TextSize = 10
                                        textLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                                        textLabel.Name = "EspText"
                                        textLabel.BackgroundTransparency = 1
                                        textLabel.TextStrokeTransparency = 0
                                        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                                        textLabel.Font = Enum.Font.SourceSansBold
                                        textLabel.Text = text
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(0.3)
                end
            end)
        else
            getgenv().ESPZombieEnabled = false
            pcall(function()
                for _, v in ipairs(workspace.EnemySpawns.Spawned:GetChildren()) do
                    if v.Name == "Lurker" then
                        local esp = v:FindFirstChild("ESP")
                        if esp then esp:Destroy() end
                        local bb = v:FindFirstChild("EspBili")
                        if bb then bb:Destroy() end
                    end
                end
            end)
        end
    end
})

Tab2:Toggle({
    Title = "绘制血量",
    Default = false,
    Callback = function(state)
        if state then
            getgenv().ESPHealthEnabled = true
            task.spawn(function()
                while getgenv().ESPHealthEnabled do
                    pcall(function()
                        local spawned = workspace.EnemySpawns.Spawned:GetChildren()
                        for i = 1, #spawned do
                            local v = spawned[i]
                            if v.Name == "Lurker" and v.PrimaryPart then
                                local healthTag = v:FindFirstChild("ESPHealthTag")
                                if healthTag then
                                    local humanoid = v:FindFirstChildOfClass("Humanoid")
                                    if humanoid and humanoid.MaxHealth > 0 then
                                        local healthPercent = math.round((humanoid.Health / humanoid.MaxHealth) * 100)
                                        local tl = healthTag:FindFirstChild("TextLabel")
                                        if tl and tl.Text ~= healthPercent .. "%" then
                                            tl.Text = healthPercent .. "%"
                                            if healthPercent > 50 then
                                                tl.TextColor3 = Color3.fromRGB(0, 255, 0)
                                            elseif healthPercent > 25 then
                                                tl.TextColor3 = Color3.fromRGB(255, 255, 0)
                                            else
                                                tl.TextColor3 = Color3.fromRGB(255, 0, 0)
                                            end
                                        end
                                    end
                                else
                                    local billboard = Instance.new("BillboardGui")
                                    billboard.Parent = v.PrimaryPart
                                    billboard.AlwaysOnTop = true
                                    billboard.Size = UDim2.new(0, 100, 0, 20)
                                    billboard.Name = "ESPHealthTag"
                                    billboard.StudsOffset = Vector3.new(0, 2, 0)
                                    billboard.MaxDistance = 500

