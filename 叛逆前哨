            jumpConnection = nil
            WindUI:Notify({
                Title = "已关闭",
                Content = "",
                Duration = 2
            })
            return
        end
        
        jumpConnection = UserInputService.JumpRequest:Connect(function()
            local character = Players.LocalPlayer.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
